      "safe_to_disable": [
        "com.samsung.android.bixby.agent",
        "com.samsung.android.bixby.service",
        "com.samsung.android.app.spage",
        "com.samsung.android.game.gamehome",
        "com.samsung.android.game.gametools",
        "com.sec.android.app.sbrowser"
      ],
      "do_not_disable": [
        "com.samsung.android.providers.context",
        "com.samsung.android.app.telephonyui",
        "com.samsung.android.incallui",
        "com.android.phone",
        "com.samsung.android.app.contacts",
        "com.samsung.android.messaging"
      ]
    },
    "logs": {
      "default_lines": 100,
      "max_lines": 10000,
      "filters": [
        "ActivityManager",
        "PackageManager",
        "SystemServer",
        "SamsungAccount",
        "Knox",
        "SEF"
      ]
    },
    "files": {
      "default_paths": [
        "/sdcard",
        "/sdcard/Download",
        "/sdcard/DCIM",
        "/sdcard/Pictures",
        "/sdcard/Samsung",
        "/sdcard/Music"
      ],
      "protected_paths": [
        "/system",
        "/vendor",
        "/data",
        "/efs",
        "/preload"
      ]
    },
    "tweaks": {
      "available": [
        "disable_bixby",
        "disable_game_launcher",
        "disable_samsung_browser",
        "disable_ads",
        "enable_call_recording",
        "disable_knox_services"
      ]
    }
  },
  "safety": {
    "dry_run_default": false,
    "auto_confirm": false,
    "dangerous_actions": [
      "flash",
      "wipe",
      "erase",
      "factory_reset",
      "disable_core_samsung_service"
    ],
    "warnings": {
      "disable_bixby": "Desactivar Bixby puede afectar el asistente de voz y funciones relacionadas",
      "disable_knox": "Desactivar Knox puede romper funciones de seguridad empresarial",
      "disable_sbrowser": "Desactivar Samsung Browser puede afectar enlaces que abren el navegador por defecto"
    }
  },
  "notes": {
    "odin_mode": "Para entrar en modo Odin: Apagar, luego Volumen Abajo + Volumen Arriba + conectar USB",
    "download_mode": "Para modo Download: Apagar, luego Volumen Abajo + Volumen Arriba + conectar USB",
    "recovery_mode": "Para Recovery: Apagar, luego Volumen Arriba + Power + Bixby (si aplica)",
    "csc_info": "El CSC determina la región y operador. Cambiarlo puede hacer factory reset",
    "knox_warning": "Si Knox se rompe (0x1), Samsung Pay, Secure Folder y garantías se pierden permanentemente"
  }
}