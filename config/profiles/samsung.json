{
  "profile": {
    "name": "samsung",
    "description": "Perfil optimizado para dispositivos Samsung (One UI)",
    "brand": "samsung",
    "android_type": "oneui",
    "supported_models": [
      "SM-A",
      "SM-G",
      "SM-N",
      "SM-S",
      "SM-M",
      "SM-F"
    ]
  },
  "adb": {
    "default_timeout": 45,
    "retry_attempts": 3,
    "retry_delay": 3,
    "max_push_size_mb": 500
  },
  "backup": {
    "default_path": "~/storage/downloads/cell_phone_modifier/backups/samsung",
    "compress": true,
    "include_apks": true,
    "include_data": false,
    "manifest": true
  },
  "modules": {
    "device_info": {
      "enabled": true,
      "properties": [
        "ro.product.model",
        "ro.product.brand",
        "ro.product.manufacturer",
        "ro.build.version.release",
        "ro.build.version.sdk",
        "ro.build.id",
        "ro.build.type",
        "ro.build.version.security_patch",
        "ro.product.cpu.abi",
        "ro.hardware",
        "ro.product.board",
        "ro.product.device",
        "ro.build.PDA",
        "ro.build.CSC",
        "ro.build.changelist",
        "ril.official_cscver"
      ]
    },
    "apps": {
      "known_bloatware": [
        "com.samsung.android.bixby.agent",
        "com.samsung.android.bixby.service",
        "com.samsung.android.visionintelligence",
